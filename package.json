{
  "name": "jp-chatting",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only app for practising Japanese typing and conversation with an AI partner.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "start:lan": "tsx server/index.ts --host",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/unit/**/*.test.ts\" \"test/unit/**/*.test.tsx\"",
    "test:ui": "playwright test",
    "test:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:ui",
    "check:claude": "tsx scripts/check-claude-models.ts",
    "eval": "tsx scripts/eval-prompts.ts",
    "kanji": "tsx scripts/build-kanji.ts",
    "postinstall": "tsx scripts/build-kanji.ts --if-missing",
    "lint": "biome lint"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  },
  "packageManager": "pnpm@12.6.0"
}
